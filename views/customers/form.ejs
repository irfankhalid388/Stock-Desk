<h1><%= customer ? "Edit Customer" : "Add Customer" %></h1>
<form id="customerForm">
  <input type="hidden" id="customerId" value="<%= customer ? customer.id : '' %>">

  <label for="name">Name</label>
  <input type="text" id="name" value="<%= customer ? customer.name : '' %>">
  <span id="err-name"></span>

  <label for="email">Email</label>
  <input type="email" id="email" value="<%= customer ? customer.email : '' %>">
  <span id="err-email"></span>

  <label for="phone">Phone</label>
  <input type="text" id="phone" value="<%= customer ? customer.phone : '' %>">
  <span id="err-phone"></span>

  <label for="address">Address</label>
  <input type="text" id="address" value="<%= customer ? customer.address : '' %>">
  <span id="err-address"></span>

  <button type="submit"><%= customer ? "Save Changes" : "Create Customer" %></button>
  <div id="formError" style="color: red;"></div>
</form>


<script src="/js/customer_form.js"></script>