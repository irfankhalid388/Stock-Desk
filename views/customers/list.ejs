<h1>Customers</h1>

<div class="toolbar">
  <input type="search" id="search" placeholder="Search customers...">
  <a href="/customers/new" class="btn" style="display: none;" id="addbtn">Add customer</a>
  <a href="/customers/summary" class="btn" style="display: none;" id="summaryLink">show summary</a>
</div>

<div id="message" role="alert"></div>

<div class="table-wrap" style="overflow-x:auto;">
  <table>
    <thead>
      <tr>
        <th>id</th>
        <th>Name</th>
        <th>Email</th>
        <th>Phone</th>
        <th>Address</th>
      </tr>
    </thead>
    <tbody id="customerRows">
      <tr><td colspan="5">Loading...</td></tr>
    </tbody>
  </table>
</div>

<div class="pagination">
  <button type="button" id="prevBtn">Previous</button>
  <span id="pageInfo"></span>
  <button type="button" id="nextBtn">Next</button>
</div>

<script src="/js/customer_list.js"></script>