<h1>Invoices</h1>

<div class="toolbar">
  <a href="/invoices/new" class="btn" style="display: none;" id="createbtn">create invoice</a>
  <input type="search" id="search" placeholder="Search by invoice no or customer...">
</div>

<div id="message" role="alert"></div>

<div class="table-wrap" style="overflow-x:auto;">
  <table>
    <thead>
      <tr>
        <th>Invoice No</th>
        <th>Customer</th>
        <th>Total</th>
        <th>Status</th>
        <th>Date</th>
      </tr>
    </thead>
    <tbody id="invoiceRows">
      <tr><td colspan="5">Loading...</td></tr>
    </tbody>
  </table>
</div>

<div class="pagination">
  <button type="button" id="prevBtn" disabled>Previous</button>
  <span id="pageInfo"></span>
  <button type="button" id="nextBtn" disabled>Next</button>
</div>

<script src="/js/invoice_list.js"></script>