<h1>Create Invoice</h1>

<div id="message" role="alert"></div>

<h2>Customer</h2>
<input type="search" id="customerSearch" placeholder="Search customer by name, id or email...">
<div id="customerResults"></div>
<div id="selectedCustomer" style="display:none; margin-top:10px;">
  Selected: <strong id="selectedCustomerName"></strong>
  <button type="button" id="clearCustomer">Change</button>
</div>

<h2>Items</h2>
<table>
  <thead>
    <tr>
      <th>Product</th>
      <th>Quantity</th>
      <th>Unit Price</th>
      <th>Line Total</th>
      <th></th>
    </tr>
  </thead>
  <tbody id="itemRows"></tbody>
</table>
<button type="button" id="addItemBtn">+ Add Item</button>

<h2>Totals</h2>
<label for="discount">Discount</label>
<input type="number" id="discount" value="0" min="0">

<label for="tax">Tax</label>
<input type="number" id="tax" value="0" min="0">

<p>Subtotal: <span id="subtotalDisplay">0</span></p>
<p>Total: <span id="totalDisplay">0</span></p>

<button type="button" id="submitInvoice">Create Invoice</button>

<script src="/js/invoice_form.js"></script>